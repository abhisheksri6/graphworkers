# kg_export worker — runtime env (copy to .env on the VM; never commit real .env).
#
# System DB (reads the canonicalized kg_entities/kg_edges + kg_canonical_entities) via the shared
# db_session decrypt path.
DB_CONNECTION_PROFILE_NAME=systemdb
PROFILE_DECRYPT_URL=http://10.73.88.101:8000/internal/connection-profiles/decrypt

CELERY_BROKER_URL=pyamqp://guest:guest@10.73.88.101:5672//
CELERY_RESULT_BACKEND=rpc://

# Backend callback (thin: node_count/relationship_count + usage[]) — handled by the generic
# single-instance KG worker-results handler (B12).
WORKER_RESULTS_URL=http://10.73.88.101:8000/kg-export/worker-results

# Single-instance node (downstream of a Hold barrier); no runtime-preview surface.
CELERY_QUEUE=kg_export
