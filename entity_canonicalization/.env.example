# entity_canonicalization worker — runtime env (copy to .env on the VM; never commit real .env).
#
# DB access via ctx_worker_shared.db_session (decrypt a named system-DB profile). The worker reads
# the batch's `staged` kg_entities/kg_edges and writes canonical_id + the staged->canonicalized
# transition through this system DB.
DB_CONNECTION_PROFILE_NAME=systemdb
PROFILE_DECRYPT_URL=http://10.73.88.101:8000/internal/connection-profiles/decrypt

CELERY_BROKER_URL=pyamqp://guest:guest@10.73.88.101:5672//
CELERY_RESULT_BACKEND=rpc://

# Backend callback (thin scalar summary: canonical/merged/minted counts + usage[]).
WORKER_RESULTS_URL=http://10.73.88.101:8000/entity-canonicalization/worker-results

# Single-instance node (downstream of a Hold barrier); no runtime-preview surface.
CELERY_QUEUE=entity_canonicalization
