# entity_extraction worker — runtime env (copy to .env on the VM; never commit real .env).
#
# DB access: the worker does NOT take a DATABASE_URL. ctx_worker_shared.db_session resolves the
# system DB by decrypting a named connection profile — set the profile name + the decrypt endpoint,
# and the shared lib fetches host/port/db/user/password. The worker reads text_chunks and writes
# kg_entities/kg_edges through this system DB.
DB_CONNECTION_PROFILE_NAME=systemdb
PROFILE_DECRYPT_URL=http://10.73.88.101:8000/internal/connection-profiles/decrypt

# Celery broker/result backend.
CELERY_BROKER_URL=pyamqp://guest:guest@10.73.88.101:5672//
CELERY_RESULT_BACKEND=rpc://

# Backend callback endpoints the worker POSTs results to.
WORKER_RESULTS_URL=http://10.73.88.101:8000/entity-extraction/worker-results
# Store-only callback for profile runtime tests (auxiliary runtime_entity_extraction queue).
RUNTIME_WORKER_RESULTS_URL=http://10.73.88.101:8000/entity-extraction/runtime-worker-results

# Guardrails sidecar (optional — unset => screening is a no-op with a logged skip).
GUARDRAILS_URL=

# spaCy en_core_web_lg-3.7.1 model, installed BY-COPY (offline, no network) — task C12.
SPACY_MODEL_PATH=./models/en_core_web_lg

# GLEIF/LEI gazetteer index (by-copy SQLite; opt-in, default off in the profile) — task C6/C12.
GAZETTEER_DB_PATH=./gazetteers/gleif_lei.sqlite

# Celery queues (must equal system_capabilities.queue_name + the aux runtime queue).
CELERY_QUEUE=entity_extraction,runtime_entity_extraction
